# Copie para .env na raiz (não commite .env com segredos reais).

NODE_ENV=development
PORT=3000

# SQLite local (predefinição: data/ec-routine.db)
# SQLITE_PATH=data/ec-routine.db

# Segredo para assinar JWT — obrigatório se NODE_ENV=production
JWT_SECRET=use-a-long-random-string-do-not-use-dev-default

# Painel admin (/admin): e-mails autorizados, separados por vírgula, minúsculas
# ADMIN_EMAILS=seuemail@gmail.com

# Open Finance (Pluggy) — módulo financeiro
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=

# Next.js + Supabase (notificações push — app/)
# NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
